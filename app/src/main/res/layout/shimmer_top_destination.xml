<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmerTopDestination"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:shimmer_auto_start="true"
    app:shimmer_duration="1300"
    android:layout_margin="@dimen/space5">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <!-- Main Circle Placeholder -->
        <View
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/shimmer_bg"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/_10dp"/>

        <!-- Flag Circle Placeholder -->
        <View
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/shimmer_bg"
            android:layout_centerHorizontal="true"
            android:layout_below="@+id/shimmer_image"
            android:layout_marginTop="-20dp" />

        <!-- Country Name Placeholder -->
        <View
            android:layout_width="80dp"
            android:layout_height="14dp"
            android:layout_below="@+id/shimmer_flag"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"
            android:background="@drawable/shimmer_bg" />

        <!-- Institutions Placeholder -->
        <View
            android:layout_width="60dp"
            android:layout_height="12dp"
            android:layout_below="@+id/shimmer_text_1"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="5dp"
            android:background="@drawable/shimmer_bg" />

    </RelativeLayout>

</com.facebook.shimmer.ShimmerFrameLayout>
