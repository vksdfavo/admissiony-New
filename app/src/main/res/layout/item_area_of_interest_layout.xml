<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/itemContainers"
    android:layout_width="130dp"
    android:layout_height="120dp"
    android:background="@color/white"
    android:layout_margin="5dp"
    app:cardUseCompatPadding="true">

    <RelativeLayout
        android:id="@+id/rlBase"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/card_strock"
        android:padding="8dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/imageview_data1_circleimageview"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/flag_india"
            android:contentDescription="@string/app_name" />


        <!-- Course / College Name -->
        <TextView
            android:id="@+id/country_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/business"
            android:layout_below="@id/imageview_data1_circleimageview"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:singleLine="true"
            android:layout_marginTop="@dimen/dp_5"
            android:ellipsize="end"
            android:maxLines="1"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/total_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/country_name"
            android:text="50+ courses"
            android:textSize="12sp" />


    </RelativeLayout>
</RelativeLayout>
