<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmerLayout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:shimmer_auto_start="true"
    app:shimmer_duration="900">

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="4dp"
        app:cardUseCompatPadding="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:background="@drawable/card_strock">

            <!-- Image Placeholder -->
            <View
                android:id="@+id/iv_shimmer"
                android:layout_width="110dp"
                android:layout_height="70dp"
                android:background="@drawable/shimmer_bg"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/favContainer_shimmer" />

            <!-- Heart Button Placeholder -->
            <androidx.cardview.widget.CardView
                android:id="@+id/favContainer_shimmer"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:cardCornerRadius="50dp"
                app:cardElevation="2dp"
                app:layout_constraintTop_toTopOf="@id/iv_shimmer"
                app:layout_constraintEnd_toEndOf="parent">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/shimmer_bg" />
            </androidx.cardview.widget.CardView>

            <!-- Divider Placeholder -->
            <View
                android:id="@+id/view_shimmer"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/shimmer_bg"
                app:layout_constraintTop_toBottomOf="@id/iv_shimmer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Program Name Placeholder -->
            <View
                android:id="@+id/title_shimmer"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/shimmer_bg"
                app:layout_constraintTop_toBottomOf="@id/view_shimmer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- College Name Placeholder -->
            <View
                android:id="@+id/college_shimmer"
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/shimmer_bg"
                app:layout_constraintTop_toBottomOf="@id/title_shimmer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Location Placeholder -->
            <View
                android:id="@+id/location_shimmer"
                android:layout_width="60dp"
                android:layout_height="11dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/shimmer_bg"
                app:layout_constraintTop_toBottomOf="@id/college_shimmer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</com.facebook.shimmer.ShimmerFrameLayout>
